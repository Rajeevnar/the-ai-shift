# Copy this file to .env and fill in real values. NEVER put real secrets in
# THIS file (.env.example) — it's meant to be committed to git as a template.

# --- Postgres (superuser connection, used ONLY for Prisma migrations) ---
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/quotation_builder?schema=public"

# --- Postgres (restricted app_user connection, used by the running API) ---
# This is the connection Row-Level Security actually applies to. Created by
# running `npm run db:secure` (see prisma/rls-policies.sql) after migrations.
APP_DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/quotation_builder?schema=public"

# --- API ---
PORT=3001 # port the NestJS API listens on
NODE_ENV=development # development | production

# --- Auth ---
# Any long random string works for local dev. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string # signs/verifies admin login JWTs

# --- Encryption (connector credentials at rest, e.g. Magento OAuth1 tokens) ---
# Must be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-char-hex-string # encrypts saved connector/email credentials

# --- Admin app's own public URL (used to build links in emails, e.g. the
# --- password-reset link) ---
ADMIN_APP_URL=http://localhost:3000

# --- The API's own public URL — used to build the logo image URL embedded
# --- in outgoing emails, since uploaded logos are stored as data: URLs in
# --- Postgres but most email clients strip/block data: URIs in <img src>.
# --- Must be a real reachable HTTPS URL once deployed. ---
API_PUBLIC_URL=http://localhost:3001

# --- Platform-wide fallback SMTP sender (OPTIONAL) ---
# Only needed if you want a default sender for tenants who haven't connected
# their own email provider from the Settings page. Every tenant can instead
# (or additionally) connect their own SMTP/Brevo/SendGrid/Postmark/Mailgun/
# Resend credentials per-tenant — see the README's "Email sending" section.
# Leave all four of these unset to skip the platform fallback entirely.
PLATFORM_SMTP_HOST= # e.g. smtp-relay.brevo.com
PLATFORM_SMTP_PORT=587 # optional, defaults to 587 if unset
PLATFORM_SMTP_USERNAME= # SMTP username for the platform fallback sender
PLATFORM_SMTP_PASSWORD= # SMTP password/API key for the platform fallback sender
PLATFORM_SMTP_FROM_EMAIL= # "From" address used when a tenant has no connector of their own
PLATFORM_SMTP_FROM_NAME= # "From" display name for the same fallback path
