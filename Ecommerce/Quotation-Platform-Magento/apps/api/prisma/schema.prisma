// Quotation Platform — core data model, v1 (Magento connector only).
// Tenant boundary = Tenant (one per client business — e.g. a catering
// company). A separate deployment/database from any other product this
// team runs — kept as a standalone product rather than a module bolted
// onto something else.
//
// Tenant isolation is enforced at the DATABASE level via real Postgres Row-
// Level Security (see prisma/rls-policies.sql + prisma/scripts/apply-rls.ts),
// the same general mechanism other products at this shop use under the
// hood (their own RLS lives in a hand-run SQL script, not in schema.prisma's DSL, which is why it's
// easy to miss on a first read). Every tenant-owned table below carries a
// direct `tenantId` column (never inferred through a join) so the session
// variable PrismaService.forTenant() sets before each query — via SET LOCAL
// app.current_tenant_id — has something to filter on. `tenants` and
// `admin_users` are the deliberate exception: not RLS-scoped, since login
// (looking up an AdminUser by email) and platform-admin cross-tenant
// management both need to run before/outside any single tenant's context.

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev (Windows) and Render (also Linux, but its
  // own container matches "native" when Prisma generate runs there
  // directly). "rhel-openssl-3.0.x" is added specifically for Vercel's
  // serverless functions, which run on Amazon Linux — without it, the
  // query engine binary generated during Vercel's build simply doesn't
  // match the runtime the function actually executes in, and the
  // function crashes on its very first Prisma call (which, since
  // PrismaService.onModuleInit calls $connect(), is on EVERY request —
  // including a bare health check, since the whole app has to finish
  // bootstrapping first).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- Tenant / Admin --------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  // Loose, informational-only reference to the client's id in another
  // internal system (e.g. a separate storefront/CMS product) — NOT a
  // foreign key, since that system lives in a completely separate
  // database/repo by design. Lets support staff cross-reference "which
  // record in that other system does this quoting tenant correspond to"
  // without coupling the two products' schemas together.
  externalSystemRef String? @map("external_system_ref")
  // Platform-admin controlled pause switch — independent of anything the
  // tenant itself does. When false, login is refused (see AuthService) and
  // any already-issued token stops working on its next request (see
  // JwtAuthGuard), so pausing takes effect immediately rather than only
  // blocking new logins.
  isActive  Boolean  @default(true) @map("is_active")

  // Branding used on generated quote/invoice emails (and later PDFs) — all
  // optional, falls back to a plain default look if unset (matches how a
  // sibling product's own widget branding is optional, never a blocker on
  // using the product).
  logoUrl    String? @map("logo_url")
  brandColor String? @map("brand_color")
  // Background of the header and footer bands in a sent email — separate
  // from brandColor, which is used as an accent border/button color, not
  // a fill. Falls back to a light grey if unset (see quote-email.template.ts).
  emailBgColor String? @map("email_bg_color")
  address    String?
  phone      String?

  // Display name shown as the email "From" — e.g. "Acme Catering Co.
  // Quotes" instead of the literal tenant name. Falls back to `name` if
  // unset. Only used for the platform-fallback send path (a tenant's own
  // connected provider has its own fromName field on EmailConnector).
  emailFromName String? @map("email_from_name")

  // Default heading shown at the top of a sent quote/invoice email — falls
  // back to the tenant's own `name` if unset.
  quoteHeaderTitle String? @map("quote_header_title")
  // Default intro ("here's your quote...") and footer ("thanks for your
  // business" etc.) copy for sent emails. Both are TENANT-WIDE defaults;
  // Quote.notes (already existed for a different purpose) doubles as the
  // per-quote override for the intro message — see EmailService.
  quoteIntroMessage  String? @map("quote_intro_message")
  quoteFooterMessage String? @map("quote_footer_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adminUsers      AdminUser[]
  connectors      StoreConnector[]
  emailConnector  EmailConnector?
  itemLibraryItems ItemLibraryItem[]
  clients         Client[]
  quotes          Quote[]
  quoteTemplates  QuoteTemplate[]

  @@map("tenants")
}

model AdminUser {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("owner") // owner | manager — scoped WITHIN a tenant

  // Separate, platform-wide flag — distinct from the per-tenant `role`
  // above. A platform admin can see and manage EVERY tenant, not just their
  // own. Deliberately no self-service way to become one — set directly in
  // the database (see prisma/scripts/seed-platform-admin.ts) by whoever
  // runs the platform, never through the public API.
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")

  // Set on a forgot-password request, cleared the moment it's used (or
  // replaced by a fresh one on the next request — only one active reset
  // link per user at a time, matching common practice). The token itself
  // is a long random string, never guessable; expiry is enforced in
  // AuthService, not by the database.
  resetToken          String?   @unique @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("admin_users")
}

// -------------------- Store connector (Magento now, others later) --------------------

// Deliberately generic even though Magento is the only implementation for
// v1 (per QUOTATION-PLATFORM-BRIEF.md: "focus now first as magento" with
// Shopify/platform-less invoicing flagged as later). Keeping `platform` an
// enum and credentials a generic JSON blob now — instead of Magento-specific
// columns on this table — means adding a ShopifyConnector or a "custom, no
// platform" tenant later is a new enum value and a new service class, not a
// schema rewrite.
enum ConnectorPlatform {
  magento
  shopify
  custom
}

enum ConnectorStatus {
  not_connected
  pending
  connected
  error
  disabled
}

model StoreConnector {
  id       String            @id @default(uuid())
  tenantId String            @map("tenant_id")
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  platform ConnectorPlatform @default(magento)
  status   ConnectorStatus   @default(not_connected)
  label    String? // merchant-facing name, e.g. "Acme Catering Magento Store"

  baseUrl  String? @map("base_url")
  // Opaque encrypted string ("iv:authTag:ciphertext", see EncryptionService)
  // wrapping a JSON payload whose shape depends on `platform` (e.g. Magento
  // OAuth1 consumer/access token pairs today — see MagentoOauthCredentials
  // in src/connectors/magento/magento-rest.client.ts — a Shopify API
  // key/secret later). Deliberately `String`, not `Json`: the stored value
  // is ciphertext, not queryable structured data. Never sent back to any
  // client.
  credentials String? @map("credentials")
  // A short, deliberately non-sensitive summary of what's saved (e.g.
  // "OAuth — Consumer Key ****ab12" or "Admin login — jane@store.com") —
  // stored in plaintext alongside the encrypted blob purely so the connect
  // form can show visible proof credentials are on file (the same "•••• 4242"
  // pattern Stripe/AWS use for saved cards/keys) without ever exposing the
  // actual secret. Recomputed every time credentials are (re)saved.
  credentialsPreview String? @map("credentials_preview")

  lastProductSyncAt     DateTime? @map("last_product_sync_at")
  // Resume-from-failure page marker — same real-world need as any other
  // catalog-sync feature that pages through a large store (large catalogs
  // + intermittent gateway timeouts meant every retry restarted from
  // page 1).
  lastSyncCompletedPage  Int?      @map("last_sync_completed_page")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products ConnectorProduct[]

  @@index([tenantId])
  @@map("store_connectors")
}

// Cached catalog pulled from a connector — the raw sync target. ItemLibraryItem
// (below) is what quotes actually reference; this table exists so a re-sync
// can update prices/stock without touching any ItemLibraryItem a tenant has
// already customized (renamed, re-priced, etc.) after importing it.
model ConnectorProduct {
  id               String         @id @default(uuid())
  storeConnectorId String         @map("store_connector_id")
  storeConnector   StoreConnector @relation(fields: [storeConnectorId], references: [id], onDelete: Cascade)

  externalId String  @map("external_id") // the source platform's own product id
  sku        String
  name       String
  price      Decimal? @db.Decimal(12, 2)
  currency   String?  @default("GBP")
  imageUrl   String?  @map("image_url")

  // Full raw payload from the source platform, preserved for recovery/future
  // mapping needs without a re-sync — same rationale as keeping a raw
  // attributes blob in any other catalog-sync schema.
  raw Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemLibraryItems ItemLibraryItem[]

  @@unique([storeConnectorId, sku])
  @@index([storeConnectorId])
  @@map("connector_products")
}

// -------------------- Item library (the Xero-style item picker) --------------------

model ItemLibraryItem {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Set only when this entry originated from a connector sync (e.g. Magento);
  // NULL for items a tenant typed in by hand. Kept as a reference, not a
  // hard dependency — deleting/disconnecting a connector must never cascade
  // into deleting items already used on real quotes.
  sourceConnectorProductId String?           @map("source_connector_product_id")
  sourceConnectorProduct   ConnectorProduct? @relation(fields: [sourceConnectorProductId], references: [id], onDelete: SetNull)

  name            String
  // Copied from the source connector product at import time (see
  // ConnectorsService.importToLibrary), or set by hand — used to search
  // the item picker by SKU as well as by name.
  sku             String?
  description     String?
  defaultUnitPrice Decimal @default(0) @map("default_unit_price") @db.Decimal(12, 2)
  defaultVatRate   Decimal @default(20) @map("default_vat_rate") @db.Decimal(5, 2)
  account         String? // free-text account/category, matching the Xero "account" column
  unit            String? // e.g. "each", "hour", "day" — optional, purely descriptive

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems         QuoteLineItem[]
  templateLineItems QuoteTemplateLineItem[]

  @@index([tenantId])
  @@unique([tenantId, sourceConnectorProductId])
  @@map("item_library_items")
}

// -------------------- Client (the customer being quoted) --------------------

model Client {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  email          String?
  phone          String?
  billingAddress String? @map("billing_address")
  // Free-form owner-defined labels (e.g. "VIP", "Corporate", "Repeat") —
  // a plain Postgres text array rather than a separate Tag table, since
  // tags here are just per-tenant descriptive labels with no need for
  // their own identity, color, or cross-client rename-in-place semantics.
  tags           String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotes Quote[]

  @@index([tenantId])
  @@map("clients")
}

// -------------------- Quote --------------------

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
}

// A Quote row IS the document, throughout its life — a quote that gets
// converted to an invoice stays the SAME row (same id, same line items,
// same audit trail via quoteNumber), it just gains an invoiceNumber and
// flips documentType. Modeling invoices as a wholly separate table would
// mean duplicating every section/line-item on conversion for no real
// benefit, since an invoice is fundamentally the same shape of document.
enum QuoteDocumentType {
  quote
  invoice
}

model Quote {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Optional — a quote can be started before a client is picked or
  // created, so the builder page can be reached immediately from "New
  // quote" instead of gating quote creation behind a client-picker step.
  // onDelete SetNull (not Restrict): since a quote no longer REQUIRES a
  // client, deleting one shouldn't be blocked by quotes that reference it.
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  documentType QuoteDocumentType @default(quote) @map("document_type")

  // Tenant-facing quote number (e.g. "Q-1042") — unique per tenant, not
  // globally, so each tenant's own numbering can start at 1. Kept
  // permanently even after conversion to an invoice, as the audit trail of
  // which quote this invoice originated from.
  quoteNumber String @map("quote_number")
  // Assigned only on conversion (see QuotesService.convertToInvoice) — its
  // own separate sequence (e.g. "INV-1001"), not reusing quoteNumber's
  // counter, so invoice numbers stay contiguous regardless of how many
  // quotes never convert.
  invoiceNumber        String?   @map("invoice_number")
  convertedToInvoiceAt DateTime? @map("converted_to_invoice_at")

  status      QuoteStatus @default(draft)
  reference   String?
  currency    String      @default("GBP")

  issueDate DateTime  @map("issue_date")
  dueDate   DateTime? @map("due_date")
  notes     String?

  sentAt      DateTime? @map("sent_at")
  acceptedAt  DateTime? @map("accepted_at")
  declinedAt  DateTime? @map("declined_at")

  // Denormalized roll-ups, recomputed and stored on every save (not derived
  // live on every read) — matches a real catering-quote spreadsheet's own
  // section-subtotal -> VAT -> grand-total logic, and keeps quote list views
  // fast without summing every line item on every page load.
  subtotal   Decimal @default(0) @map("subtotal") @db.Decimal(12, 2)
  vatTotal   Decimal @default(0) @map("vat_total") @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @map("grand_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections   QuoteSection[]
  activities QuoteActivity[]

  @@unique([tenantId, quoteNumber])
  // Postgres allows multiple NULLs in a unique index, so quotes never
  // converted to an invoice (invoiceNumber left NULL) don't collide.
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("quotes")
}

// A real event log — sentAt/acceptedAt/declinedAt on Quote itself only ever
// capture the FIRST time each happened, so resending an already-sent quote
// silently updated nothing and looked identical to never resending it at
// all. This table records every individual occurrence (each send, each
// status change, each convert/revert), so "sent 3 times" is something the
// UI can actually show instead of collapsing to a single timestamp.
// Deliberately NOT used for line-item/section edits — those would be one
// row per autosaved keystroke, far too noisy to be useful; Quote.updatedAt
// already covers "last edited" as a single rollup, which is what's useful
// there.
model QuoteActivity {
  id      String @id @default(uuid())
  quoteId String @map("quote_id")
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  type QuoteActivityType
  // e.g. the recipient email for a 'sent' event — null for the others.
  detail String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quoteId])
  @@map("quote_activities")
}

enum QuoteActivityType {
  sent
  accepted
  declined
  converted_to_invoice
  reverted_to_quote
}

// Ordered tabbed groups within a quote (e.g. a catering quote's "Arrival
// 9:30-10:30am" / "12:15-13:30" / "Additional Staff & Equipment" tabs).
model QuoteSection {
  id      String @id @default(uuid())
  quoteId String @map("quote_id")
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  title    String
  position Int    @default(0) // display/tab order within the quote

  // Denormalized, recomputed alongside Quote.subtotal/vatTotal whenever this
  // section's line items change.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  vatTotal Decimal @default(0) @map("vat_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems QuoteLineItem[]

  @@index([quoteId])
  @@map("quote_sections")
}

model QuoteLineItem {
  id             String       @id @default(uuid())
  quoteSectionId String       @map("quote_section_id")
  quoteSection   QuoteSection @relation(fields: [quoteSectionId], references: [id], onDelete: Cascade)

  // Set only when picked from the item library (Xero-style item picker);
  // NULL for a line typed freehand. Kept as a reference, not a hard
  // dependency — editing/deleting a library item must never change or break
  // a quote line that already quoted a customer a specific price.
  itemLibraryItemId String?          @map("item_library_item_id")
  itemLibraryItem   ItemLibraryItem? @relation(fields: [itemLibraryItemId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  // Percentage, e.g. 10 = 10% off — matches the Xero reference UI's
  // "discount" column. Applied before VAT.
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  account     String? // free-text account/category, matching the Xero "account" column
  vatRate     Decimal @default(20) @map("vat_rate") @db.Decimal(5, 2)

  // Computed and stored on every save (never derived live): amount = net
  // line total after discount, before VAT; taxAmount = amount * vatRate/100.
  // Matches the Xero reference UI's own "amount" / "tax amount" columns.
  amount    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)

  position Int @default(0) // display order within the section

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([quoteSectionId])
  @@map("quote_line_items")
}

// -------------------- Quote templates (starter layouts) --------------------

// A reusable starting point for new quotes — either built from scratch or
// captured from an existing quote via "Save as template" (see
// QuotesService.saveAsTemplate). Deliberately a separate set of tables
// rather than a "isTemplate" flag on Quote itself: a template has no
// client, no status, no dates, and no computed totals worth persisting
// (its prices are just reference defaults, recomputed for real once
// they're copied into an actual quote) — reusing the Quote shape would
// mean a pile of always-null columns and status values that don't apply.
model QuoteTemplate {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections QuoteTemplateSection[]

  @@index([tenantId])
  @@map("quote_templates")
}

model QuoteTemplateSection {
  id              String        @id @default(uuid())
  quoteTemplateId String        @map("quote_template_id")
  quoteTemplate   QuoteTemplate @relation(fields: [quoteTemplateId], references: [id], onDelete: Cascade)

  title    String
  position Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems QuoteTemplateLineItem[]

  @@index([quoteTemplateId])
  @@map("quote_template_sections")
}

model QuoteTemplateLineItem {
  id                     String               @id @default(uuid())
  quoteTemplateSectionId String               @map("quote_template_section_id")
  quoteTemplateSection   QuoteTemplateSection @relation(fields: [quoteTemplateSectionId], references: [id], onDelete: Cascade)

  // Same reasoning as QuoteLineItem.itemLibraryItemId — a reference, not a
  // hard dependency.
  itemLibraryItemId String?          @map("item_library_item_id")
  itemLibraryItem   ItemLibraryItem? @relation(fields: [itemLibraryItemId], references: [id], onDelete: SetNull)

  description     String
  quantity        Decimal @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  account         String?
  vatRate         Decimal @default(20) @map("vat_rate") @db.Decimal(5, 2)

  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([quoteTemplateSectionId])
  @@map("quote_template_line_items")
}

// -------------------- Email sending (per-tenant, provider-agnostic) --------------------

// Nearly every transactional email provider (Brevo, SendGrid, Postmark,
// Mailgun) exposes a standard SMTP relay alongside its own REST API — so
// rather than building a separate integration per provider, this is ONE
// generic SMTP sender with presets that pre-fill the right host/port for
// each. `custom` covers anything else (a tenant's own mail server, Gmail,
// etc.). If a tenant hasn't connected one, EmailService falls back to a
// platform-level SMTP config from environment variables, using the
// tenant's own brand name as the From Name.
enum EmailProviderPreset {
  brevo
  sendgrid
  postmark
  mailgun
  resend
  custom
}

model EmailConnector {
  id       String @id @default(uuid())
  // One per tenant (not a list like StoreConnector) — v1 doesn't need a
  // tenant sending through multiple providers at once.
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider EmailProviderPreset @default(custom)
  status   ConnectorStatus     @default(not_connected)

  fromEmail String @map("from_email")
  fromName  String @map("from_name")

  smtpHost     String @map("smtp_host")
  smtpPort     Int    @map("smtp_port")
  smtpUsername String @map("smtp_username")
  // Encrypted the same way as StoreConnector.credentials — see
  // EncryptionService. Holds just the SMTP password/API-key-as-password.
  credentials  String @map("credentials")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_connectors")
}
